<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LANShare.App.MainWindow"
        Title="LANShare"
        Icon="avares://LANShare/Assets/icon.ico"
        Width="1000" Height="640"
        MinWidth="720" MinHeight="480">

    <Window.Styles>
        <!-- Abas do painel de escolha (Monitores inteiros / Janela específica) -->
        <Style Selector="Button.pickerTab">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="Margin" Value="6,6,6,0" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="Button.pickerTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22272E" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.pickerTab:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A3038" />
        </Style>
        <Style Selector="Button.pickerTab.active">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="#262B33" />
            <Setter Property="BorderBrush" Value="#4F7CFF" />
        </Style>
        <Style Selector="Button.pickerTab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A3038" />
            <Setter Property="BorderBrush" Value="#4F7CFF" />
        </Style>

        <!-- Cartões de monitor e de janela -->
        <Style Selector="ListBoxItem.source">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#22272E" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBoxItem.source /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBoxItem.source:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A3038" />
        </Style>
        <Style Selector="ListBoxItem.source:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#24304A" />
            <Setter Property="BorderBrush" Value="#4F7CFF" />
        </Style>
        <Style Selector="ListBoxItem.source:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A3854" />
            <Setter Property="BorderBrush" Value="#4F7CFF" />
        </Style>
        <Style Selector="ListBoxItem.source:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#24304A" />
            <Setter Property="BorderBrush" Value="#4F7CFF" />
        </Style>
        <Style Selector="ListBoxItem.source:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A3854" />
        </Style>

        <!-- Cartão de perfil -->
        <Style Selector="Border#AvatarButton:pointerover">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button#SettingsButton">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button#SettingsButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2E343C" />
        </Style>
        <Style Selector="Border#AvatarDropZone:pointerover">
            <Setter Property="BorderBrush" Value="#4F7CFF" />
        </Style>
    </Window.Styles>

    <Grid>

        <!-- Layout principal: lateral + área grande -->
        <Grid x:Name="MainLayout" ColumnDefinitions="300,*">

            <!-- Painel lateral -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="#1B1F24" Padding="20">
                <DockPanel LastChildFill="True">

                    <!-- Título com a versão (clicar em "LANShare" abre a página do projeto no GitHub) -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                        <TextBlock x:Name="TitleText" Text="LANShare" FontSize="24" FontWeight="SemiBold"
                                   Cursor="Hand"
                                   ToolTip.Tip="Abrir a página do LANShare no GitHub"
                                   PointerPressed="OnTitlePointerPressed" />
                        <TextBlock x:Name="VersionText" FontSize="13" Opacity="0.6"
                                   VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </StackPanel>

                    <!-- Rodapé fixo (todas as telas): apoio + perfil -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
                        <Button Classes="support" Content="Apoie o LANShare"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Click="OnSupportClick" />

                        <Border Background="#23282F" CornerRadius="10" Padding="10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border x:Name="AvatarButton" Width="44" Height="44" Cursor="Hand"
                                        Background="Transparent" VerticalAlignment="Center"
                                        ToolTip.Tip="Alterar avatar">
                                    <Ellipse x:Name="AvatarImage" Width="44" Height="44" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBox x:Name="ProfileNameBox" Classes="inline" MaxLength="24"
                                             ToolTip.Tip="Clique para editar o nome" />
                                    <TextBlock x:Name="ProfileNameError" Foreground="#FF6B6B" FontSize="12"
                                               TextWrapping="Wrap" IsVisible="False" />
                                </StackPanel>

                                <Button x:Name="SettingsButton" Grid.Column="2" Width="40" Height="40" Padding="7"
                                        VerticalAlignment="Center" ToolTip.Tip="Configurações (em breve)">
                                    <Image Source="avares://LANShare/Assets/settings.png" Width="26" Height="26" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Os três painéis ocupam o mesmo espaço; só um aparece por vez -->
                    <Grid>

                        <!-- ── Início ── -->
                        <StackPanel x:Name="HomePanel" Spacing="8">
                            <TextBlock Text="COMEÇAR" FontSize="11" Opacity="0.5" />
                            <Button x:Name="CreateRoomButton" Content="Criar sala"
                                    HorizontalAlignment="Stretch" />
                            <Button x:Name="JoinRoomButton" Content="Entrar em sala"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- ── Criar sala (Host) ── -->
                        <DockPanel x:Name="HostPanel" LastChildFill="True" IsVisible="False">

                            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="ResolutionBox" SelectedIndex="1" Width="126">
                                        <ComboBoxItem>720p</ComboBoxItem>
                                        <ComboBoxItem>1080p</ComboBoxItem>
                                    </ComboBox>
                                    <ComboBox x:Name="FpsBox" SelectedIndex="1" Width="126">
                                        <ComboBoxItem>15 FPS</ComboBoxItem>
                                        <ComboBoxItem>30 FPS</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="StartStreamButton" Content="Iniciar transmissão"
                                        HorizontalAlignment="Stretch" IsEnabled="False" />
                                <Button x:Name="StopStreamButton" Content="Parar transmissão"
                                        HorizontalAlignment="Stretch" IsEnabled="False" />

                                <!-- Só aparece com a sala fechada (com ela aberta, "Fechar sala" já volta ao início) -->
                                <Button x:Name="HostBackButton" Content="Voltar ao início"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="STATUS" FontSize="11" Opacity="0.5" />
                                <TextBlock x:Name="StatusLabel" Text="Sala fechada" />

                                <TextBlock Text="CONEXÃO" FontSize="11" Opacity="0.5" Margin="0,12,0,0" />
                                <TextBox x:Name="RoomNameBox" PlaceholderText="Nome da sala (opcional)" />
                                <TextBox x:Name="PasswordBox" PlaceholderText="Senha (opcional)" PasswordChar="●" />
                                <Button x:Name="RoomButton" Content="Abrir sala" HorizontalAlignment="Stretch" />

                                <TextBlock Text="USUÁRIOS NA SALA" FontSize="11" Opacity="0.5" Margin="0,12,0,0" />
                                <ScrollViewer MaxHeight="220">
                                    <StackPanel x:Name="UsersPanel" Spacing="8" />
                                </ScrollViewer>
                            </StackPanel>
                        </DockPanel>

                        <!-- ── Entrar em sala (Client) ── -->
                        <DockPanel x:Name="ClientPanel" LastChildFill="True" IsVisible="False">

                            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
                                <Button x:Name="ClientDisconnectButton" Content="Desconectar"
                                        HorizontalAlignment="Stretch" IsVisible="False" />
                                <Button x:Name="ClientBackButton" Content="Voltar ao início"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <ScrollViewer>
                                <StackPanel Spacing="6" Margin="0,0,8,0">
                                    <TextBlock Text="STATUS" FontSize="11" Opacity="0.5" />
                                    <TextBlock x:Name="ClientStatusLabel" Text="Desconectado" />

                                    <TextBlock x:Name="ClientUsersHeader" Text="USUÁRIOS NA SALA" FontSize="11"
                                               Opacity="0.5" Margin="0,12,0,0" IsVisible="False" />
                                    <StackPanel x:Name="ClientUsersPanel" Spacing="8" IsVisible="False" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                    </Grid>
                </DockPanel>
            </Border>

            <!-- Área grande: salas / conexão / vídeo + barra de informações -->
            <Border Grid.Column="1" Background="#111418">
                <Grid RowDefinitions="*,Auto">

                    <Grid Grid.Row="0">

                        <!-- Client desconectado: lista de salas e entrada por IP -->
                        <Grid x:Name="ClientLobby" ColumnDefinitions="3*,2*" Margin="32" IsVisible="False">

                            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock DockPanel.Dock="Top" Classes="section" Text="SALAS NA REDE" />
                                <Border Classes="card">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                            <TextBlock Classes="cardTitle" Text="Salas na rede atual"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="RefreshRoomsButton"
                                                    Padding="12,6" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Classes="icon" Text="&#xE72C;" />
                                                    <TextBlock Text="Atualizar" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Top" x:Name="RoomsStatusText"
                                                   Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                                                   Margin="0,0,0,10" IsVisible="False" />
                                        <ListBox x:Name="RoomsList" Classes="rooms" />
                                    </DockPanel>
                                </Border>
                            </DockPanel>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                <TextBlock Classes="section" Text="CONEXÃO POR IP" />
                                <Border Classes="card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="cardTitle" Text="Ou entre por IP" />
                                        <TextBox x:Name="ClientAddressBox"
                                                 PlaceholderText="IP da sala (ex.: 192.168.0.10)" />
                                        <Button x:Name="ClientConnectButton" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Conectar" />
                                                <TextBlock Classes="icon" Text="&#xE71B;" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Client conectando: andamento e pedido de senha -->
                        <Border x:Name="ClientConnecting" Classes="card" Width="380"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="ConnectingTitle" Classes="cardTitle" Text="Conectando..."
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ConnectingText" Opacity="0.7" TextWrapping="Wrap" />

                                <!-- Só aparece quando o Host pede senha -->
                                <StackPanel x:Name="PasswordPanel" Spacing="8" IsVisible="False">
                                    <TextBlock x:Name="PasswordHint" Text="Esta sala tem senha." />
                                    <TextBox x:Name="ClientPasswordBox" PlaceholderText="Senha da sala"
                                             PasswordChar="●" />
                                    <Button x:Name="PasswordConfirmButton" Content="Entrar"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                </StackPanel>

                                <Button x:Name="ConnectingCancelButton" Content="Cancelar"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Preview do Host / tela recebida no Client -->
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="16" IsVisible="False" />
                        <TextBlock x:Name="PlaceholderText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="32"
                                   Opacity="0.7"
                                   Text="" />
                    </Grid>

                    <TextBlock x:Name="InfoText" Grid.Row="1"
                               Margin="16,0,16,12"
                               TextWrapping="Wrap"
                               Opacity="0.8"
                               Text="" />
                </Grid>
            </Border>

        </Grid>

        <!-- Escolha do que transmitir (por cima de tudo, com o fundo escurecido) -->
        <Border x:Name="SourcePicker" Background="#B3000000" IsVisible="False">
            <Border Background="#1B1F24" BorderBrush="#2E343C" BorderThickness="1"
                    CornerRadius="12" Padding="20" Width="700"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 40 0 #80000000">
                <StackPanel Spacing="16">

                    <Border Background="#15191E" BorderBrush="#2E343C" BorderThickness="1"
                            CornerRadius="8" ClipToBounds="True">
                        <StackPanel>

                            <!-- Abas -->
                            <Grid ColumnDefinitions="*,*">
                                <Button x:Name="MonitorsTabButton" Grid.Column="0" Classes="pickerTab active">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="icon" Text="&#xE7F4;" VerticalAlignment="Center" />
                                        <TextBlock Text="Monitores inteiros" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WindowsTabButton" Grid.Column="1" Classes="pickerTab">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="icon" Text="&#xE7C4;" VerticalAlignment="Center" />
                                        <TextBlock Text="Janela específica" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Height="1" Background="#2E343C" />

                            <TextBlock x:Name="PickerStatus" Opacity="0.7" Margin="14,12,14,0"
                                       TextWrapping="Wrap" IsVisible="False" />

                            <!-- As duas listas ocupam o mesmo lugar; só a da aba aberta aparece -->
                            <Grid Height="380">
                                <ListBox x:Name="MonitorList" Background="Transparent" Margin="6"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <ListBox x:Name="WindowList" Background="Transparent" Margin="6"
                                         IsVisible="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,12,*">
                        <Button x:Name="PickerCancelButton" Grid.Column="0" Content="Cancelar"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,10" />
                        <Button x:Name="PickerConfirmButton" Grid.Column="2" Content="Iniciar transmissão"
                                Classes="accent"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,10" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Troca de avatar (por cima de tudo, com o fundo escurecido) -->
        <Border x:Name="AvatarEditor" Background="#B3000000" IsVisible="False">
            <Border Background="#1B1F24" BorderBrush="#2E343C" BorderThickness="1"
                    CornerRadius="12" Padding="24" Width="360"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 40 0 #80000000">
                <StackPanel Spacing="16">

                    <TextBlock Text="Alterar avatar" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />

                    <Grid Width="280" Height="280" HorizontalAlignment="Center">

                        <!-- Sem imagem: clicar escolhe, ou arrasta para cá -->
                        <Border x:Name="AvatarDropZone" Background="#15191E" BorderBrush="#3A414B"
                                BorderThickness="2" CornerRadius="10" Cursor="Hand">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                <TextBlock Classes="icon" Text="&#xEB9F;" FontSize="36" Opacity="0.7"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Clique para escolher uma imagem" HorizontalAlignment="Center" />
                                <TextBlock Text="ou arraste ela para cá" Opacity="0.6"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Com imagem: arraste para posicionar dentro do círculo -->
                        <Border x:Name="AvatarCropArea" Background="#0F1216" CornerRadius="10"
                                ClipToBounds="True" Cursor="SizeAll" IsVisible="False">
                            <Panel>
                                <Canvas>
                                    <Image x:Name="AvatarCropImage" Stretch="Fill" />
                                </Canvas>
                                <Path Fill="#B0000000" IsHitTestVisible="False">
                                    <Path.Data>
                                        <GeometryGroup FillRule="EvenOdd">
                                            <RectangleGeometry Rect="0,0,280,280" />
                                            <EllipseGeometry Rect="20,20,240,240" />
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                                <Ellipse Width="240" Height="240" Stroke="White" StrokeThickness="2"
                                         Opacity="0.8" IsHitTestVisible="False" />
                            </Panel>
                        </Border>
                    </Grid>

                    <!-- Zoom -->
                    <Grid x:Name="AvatarZoomRow" ColumnDefinitions="Auto,*,Auto" IsVisible="False">
                        <TextBlock Classes="icon" Text="&#xE71F;" Opacity="0.7" VerticalAlignment="Center" />
                        <Slider x:Name="AvatarZoomSlider" Grid.Column="1" Minimum="1" Maximum="4"
                                Value="1" Margin="10,0" />
                        <TextBlock Grid.Column="2" Classes="icon" Text="&#xE8A3;" Opacity="0.7"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Button x:Name="AvatarChooseButton" Content="Escolher outra imagem"
                            HorizontalAlignment="Center" IsVisible="False" />

                    <TextBlock x:Name="AvatarEditorError" Foreground="#FF6B6B" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center" IsVisible="False" />

                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,8,*">
                            <Button x:Name="AvatarCancelButton" Grid.Column="0" Content="Cancelar"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="0,10" />
                            <Button x:Name="AvatarSaveButton" Grid.Column="2" Content="Salvar"
                                    Classes="accent" IsEnabled="False"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="0,10" />
                        </Grid>
                        <Button x:Name="AvatarRemoveButton" Content="Remover avatar"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Foreground="#FF8A8A" Background="Transparent" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Tela de nome de usuário (primeira abertura, por cima de tudo, dentro do app) -->
        <Border x:Name="NameScreen" Background="#111418" IsVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340" Spacing="10">
                <TextBlock Text="Seja bem-vindo ao LANShare"
                           FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="Para começar, insira seu nome de usuário"
                           Opacity="0.8" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBox x:Name="NameInput" PlaceholderText="Digite seu nome de usuário..." MaxLength="24" />
                <TextBlock x:Name="NameError" Foreground="#FF6B6B" FontSize="12"
                           TextWrapping="Wrap" IsVisible="False" />
                <Button x:Name="NameConfirmButton" Content="Confirmar"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Content="Cancelar" IsEnabled="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
        </Border>

    </Grid>
</Window>