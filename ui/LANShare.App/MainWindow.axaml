<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LANShare.App.MainWindow"
        Title="LANShare"
        Width="1000" Height="640"
        MinWidth="720" MinHeight="480">

    <Grid ColumnDefinitions="300,*">

        <!-- Painel lateral -->
        <Border Grid.Column="0" Background="#1B1F24" Padding="20">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
                    <TextBlock Text="LANShare" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Opacity="0.7" Text="..." />
                </StackPanel>

                <!-- Botões de transmissão -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ResolutionBox" SelectedIndex="1" Width="130">
                            <ComboBoxItem>720p</ComboBoxItem>
                            <ComboBoxItem>1080p</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="FpsBox" SelectedIndex="1" Width="130">
                            <ComboBoxItem>15 FPS</ComboBoxItem>
                            <ComboBoxItem>30 FPS</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="StartStreamButton" Content="Iniciar transmissão"
                            HorizontalAlignment="Stretch" IsEnabled="False" />
                    <Button x:Name="StopStreamButton" Content="Parar transmissão"
                            HorizontalAlignment="Stretch" IsEnabled="False" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="STATUS" FontSize="11" Opacity="0.5" />
                    <TextBlock x:Name="StatusLabel" Text="Sala fechada" />

                    <TextBlock Text="CONEXÃO" FontSize="11" Opacity="0.5" Margin="0,12,0,0" />
                    <TextBox x:Name="RoomNameBox" PlaceholderText="Nome da sala (opcional)" />
                    <TextBox x:Name="PasswordBox" PlaceholderText="Senha (opcional)" PasswordChar="●" />
                    <Button x:Name="RoomButton" Content="Abrir sala" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="AddressLabel" Opacity="0.7" TextWrapping="Wrap" />

                    <TextBlock Text="USUÁRIOS" FontSize="11" Opacity="0.5" Margin="0,12,0,0" />
                    <ScrollViewer MaxHeight="180">
                        <StackPanel x:Name="UsersPanel" Spacing="4" />
                    </ScrollViewer>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Área do vídeo / log -->
        <Border Grid.Column="1" Background="#111418">
            <TextBlock x:Name="StatusText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="32"
                       Opacity="0.7"
                       Text="" />
        </Border>

    </Grid>
</Window>