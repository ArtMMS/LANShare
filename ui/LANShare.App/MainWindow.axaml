<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LANShare.App.MainWindow"
        Title="LANShare"
        Width="960" Height="600"
        MinWidth="640" MinHeight="400">

    <!-- Esqueleto do conceito: painel lateral + área do vídeo -->
    <Grid ColumnDefinitions="280,*">

        <Border Grid.Column="0" Background="#1B1F24" Padding="24">
            <StackPanel Spacing="6">
                <TextBlock Text="LANShare" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Opacity="0.7" Text="..." />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#111418">
            <TextBlock x:Name="StatusText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="32"
                       Opacity="0.7"
                       Text="" />
        </Border>

    </Grid>
</Window>