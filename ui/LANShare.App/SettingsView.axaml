<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:LANShare.App"
             x:Class="LANShare.App.SettingsView"
             MaxWidth="760" MaxHeight="600">

    <UserControl.Styles>
        <!-- Cartões de seção -->
        <Style Selector="Border.settingsCard">
            <Setter Property="Background" Value="#15191E" />
            <Setter Property="BorderBrush" Value="#2E343C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBlock.cardHeader">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="16,12" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#2E343C" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Aviso (ex.: o dispositivo de áudio escolhido não está conectado) -->
        <Style Selector="TextBlock.hint.warning">
            <Setter Property="Foreground" Value="#E8B04B" />
            <Setter Property="Opacity" Value="0.95" />
        </Style>

        <!-- Escolha em blocos (1080p / 720p, 30 / 15 FPS) -->
        <Style Selector="Button.segment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="Button.segment.selected">
            <Setter Property="Background" Value="#2E343C" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.segment.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#353C45" />
        </Style>

        <!-- Botão da tecla do atalho -->
        <Style Selector="Button.keyCap">
            <Setter Property="Background" Value="#23282F" />
            <Setter Property="BorderBrush" Value="#3A424C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.keyCap.capturing /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#4F7CFF" />
            <Setter Property="Background" Value="#1F2A3A" />
        </Style>

        <!-- Título de cartão que abre/fecha (ex.: Apps que não transmitem som) -->
        <Style Selector="Button.cardToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.cardToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1B2027" />
        </Style>

        <Style Selector="Button#CloseButton">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button#CloseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2E343C" />
        </Style>
    </UserControl.Styles>

    <Border Background="#1B1F24" BorderBrush="#4F7CFF" BorderThickness="1"
            CornerRadius="12" BoxShadow="0 12 40 0 #80000000">
        <DockPanel>

            <!-- Título e botão de fechar -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="20,14,12,10">
                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center">
                    <Image Source="avares://LANShare/Assets/settings.png" Width="28" Height="28" />
                    <TextBlock Text="{l:Tr Settings_Title}" FontSize="24" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Width="36" Height="36" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="{l:Tr Settings_CloseTooltip}">
                    <TextBlock Classes="icon" Text="&#xE711;" FontSize="14" />
                </Button>
            </Grid>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto,16,Auto" Margin="20,4,20,20">

                    <!-- Coluna da esquerda -->
                    <StackPanel Grid.Column="0" Spacing="16">

                        <Border Classes="settingsCard">
                            <StackPanel>
                                <TextBlock Classes="cardHeader" Text="{l:Tr Settings_Shortcuts}" />
                                <Border Classes="divider" />
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                        <TextBlock Text="{l:Tr Settings_Fullscreen}" />
                                        <TextBlock Classes="hint"
                                                   Text="{l:Tr Settings_ShortcutHint}" />
                                    </StackPanel>
                                    <Button x:Name="ShortcutButton" Grid.Column="1" Classes="keyCap"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settingsCard">
                            <StackPanel>
                                <TextBlock Classes="cardHeader" Text="{l:Tr Settings_StreamPrefs}" />
                                <Border Classes="divider" />
                                <StackPanel Margin="16,12" Spacing="10">
                                    <TextBlock Text="{l:Tr Settings_DefaultResolution}" />
                                    <Border Background="#0F1216" CornerRadius="8" Padding="4">
                                        <Grid ColumnDefinitions="*,4,*">
                                            <Button x:Name="Res1080Button" Grid.Column="0" Classes="segment"
                                                    Content="1080p" />
                                            <Button x:Name="Res720Button" Grid.Column="2" Classes="segment"
                                                    Content="720p" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{l:Tr Settings_DefaultFps}" Margin="0,6,0,0" />
                                    <Border Background="#0F1216" CornerRadius="8" Padding="4">
                                        <Grid ColumnDefinitions="*,4,*">
                                            <Button x:Name="Fps30Button" Grid.Column="0" Classes="segment"
                                                    Content="30 FPS" />
                                            <Button x:Name="Fps15Button" Grid.Column="2" Classes="segment"
                                                    Content="15 FPS" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Classes="hint"
                                               Text="{l:Tr Settings_StreamHint}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Coluna da direita -->
                    <StackPanel Grid.Column="2" Spacing="16">

                        <Border Classes="settingsCard">
                            <StackPanel>
                                <TextBlock Classes="cardHeader" Text="{l:Tr Settings_AudioNotifications}" />
                                <Border Classes="divider" />

                                <StackPanel Margin="16,12" Spacing="6">
                                    <TextBlock Text="{l:Tr Settings_AudioOutput}" />
                                    <!-- Os itens vêm do Rust (lanshare_audio_output_devices) ao abrir o painel -->
                                    <ComboBox x:Name="AudioDeviceBox" HorizontalAlignment="Stretch" />
                                    <TextBlock x:Name="AudioDeviceHint" Classes="hint"
                                               Text="{l:Tr Settings_AudioOutputHint}" />
                                </StackPanel>

                                <Border Classes="divider" />

                                <StackPanel Margin="16,12" Spacing="10">
                                    <TextBlock Text="{l:Tr Settings_NotificationSounds}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{l:Tr Settings_SoundJoinLeave}" Opacity="0.85"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="SoundJoinLeaveSwitch" Grid.Column="1"
                                                      OnContent="" OffContent="" MinWidth="0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{l:Tr Settings_SoundStream}" Opacity="0.85"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="SoundStreamSwitch" Grid.Column="1"
                                                      OnContent="" OffContent="" MinWidth="0" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="settingsCard">
                            <StackPanel>
                                <TextBlock Classes="cardHeader" Text="{l:Tr Settings_Updates}" />
                                <Border Classes="divider" />
                                <StackPanel Margin="16,12" Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{l:Tr Settings_AutoUpdate}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="AutoUpdateSwitch" Grid.Column="1"
                                                      OnContent="" OffContent="" MinWidth="0" />
                                    </Grid>
                                    <TextBlock Classes="hint"
                                               Text="{l:Tr Settings_AutoUpdateHint}" />

                                    <Button x:Name="CheckUpdatesButton" Content="{l:Tr Settings_CheckNow}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Margin="0,4,0,0" />
                                    <TextBlock x:Name="UpdateStatusText" Classes="hint" IsVisible="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Apps que não transmitem som (largura inteira, recolhido: clicar no título abre) -->
                    <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="settingsCard" ClipToBounds="True">
                        <StackPanel>
                            <Button x:Name="ExcludedAppsHeader" Classes="cardToggle">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{l:Tr Settings_ExcludedApps}" FontSize="16"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ExcludedAppsChevron" Grid.Column="1" Classes="icon"
                                               Text="&#xE70D;" FontSize="12" Opacity="0.7" />
                                </Grid>
                            </Button>

                            <StackPanel x:Name="ExcludedAppsContent" IsVisible="False">
                                <Border Classes="divider" />
                                <StackPanel Margin="16,12" Spacing="10">
                                    <TextBlock Classes="hint" Text="{l:Tr Settings_ExcludedAppsHint}" />

                                    <!-- Uma linha por app (montadas no SettingsView.axaml.cs) -->
                                    <StackPanel x:Name="ExcludedAppsPanel" Spacing="6" />

                                    <Button x:Name="AddAudioAppButton" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="icon" Text="&#xE710;" FontSize="12" />
                                            <TextBlock Text="{l:Tr Settings_AddAudioApp}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Abre ao clicar em "Adicionar app": apps com som + selecionar diretório -->
                                    <Border x:Name="AudioAppsBox" Background="#0F1216" CornerRadius="8"
                                            Padding="10" IsVisible="False">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{l:Tr Settings_AudioAppsTitle}" FontSize="12" Opacity="0.8" />
                                            <TextBlock x:Name="AudioAppsStatus" Classes="hint" IsVisible="False" />
                                            <StackPanel x:Name="AudioAppsPanel" Spacing="4" />

                                            <Border Classes="divider" Margin="0,4" />
                                            <Button x:Name="BrowseExeButton" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Classes="icon" Text="&#xE8B7;" FontSize="12" />
                                                    <TextBlock Text="{l:Tr Settings_BrowseExe}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Idioma (largura inteira, no fim do painel) -->
                    <Border Grid.Row="4" Grid.ColumnSpan="3" Classes="settingsCard">
                        <StackPanel>
                            <TextBlock Classes="cardHeader" Text="{l:Tr Settings_Language}" />
                            <Border Classes="divider" />
                            <StackPanel Margin="16,12" Spacing="10">
                                <Border Background="#0F1216" CornerRadius="8" Padding="4">
                                    <Grid ColumnDefinitions="*,4,*,4,*">
                                        <Button x:Name="LangPtButton" Grid.Column="0" Classes="segment"
                                                Content="Português" />
                                        <Button x:Name="LangEnButton" Grid.Column="2" Classes="segment"
                                                Content="English" />
                                        <Button x:Name="LangEsButton" Grid.Column="4" Classes="segment"
                                                Content="Español" />
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="LanguageHint" Classes="hint"
                                           Text="{l:Tr Settings_LanguageHint}" />

                                <!-- Só aparece quando o idioma escolhido é diferente do que está em uso -->
                                <Grid x:Name="RestartRow" ColumnDefinitions="*,Auto" IsVisible="False">
                                    <TextBlock x:Name="RestartText" Text="{l:Tr Settings_RestartPending}"
                                               Foreground="#7CA7FF" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button x:Name="RestartButton" Grid.Column="1" Classes="accent"
                                            Content="{l:Tr Settings_RestartNow}" Padding="16,8"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>


