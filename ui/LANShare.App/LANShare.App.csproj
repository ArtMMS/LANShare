<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LANShare</AssemblyName>
    <RootNamespace>LANShare.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>

    <!-- Versão do app: ÚNICA fonte. A tag da release no GitHub deve ser igual (ex.: v0.5.0) -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <!-- Publicação: um único LANShare.exe (Windows x64), com o .NET e a DLL do Rust embutidos -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.*" />
    <PackageReference Include="Avalonia.Desktop" Version="12.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.*" />
    <!-- Toca os sons (MP3) no Windows -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- Imagens e sons embutidos no programa -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\icon.ico" Link="Assets/icon.ico" />
    <AvaloniaResource Include="..\..\assets\default_avatar.jpg" Link="Assets/default_avatar.jpg" />
    <AvaloniaResource Include="..\..\assets\settings.png" Link="Assets/settings.png" />
    <AvaloniaResource Include="..\..\assets\sounds\*.mp3" Link="Assets/sounds/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Compila o motor Rust antes de compilar o C# (precisa do cargo no PATH) -->
  <Target Name="BuildRustCore" BeforeTargets="BeforeBuild">
    <Exec Command="cargo build --release -p lanshare-ffi" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." />
  </Target>

  <!-- A DLL do Rust vai junto do programa (e, no publish, para dentro do exe único) -->
  <ItemGroup>
    <Content Include="..\..\target\release\lanshare_ffi.dll" Link="lanshare_ffi.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>